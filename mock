def generate_mock_locations():
    """
    Generate US BESS locations with complete metadata
    
    Returns:
        List of 69 location dictionaries across 10 states
    
    Example location:
        {
            'site_id': 'CA-Site-001',
            'name': 'California Grid Stabilization BESS #1',
            'state': 'California',
            'state_abbr': 'CA',
            'latitude': 34.5522,
            'longitude': -117.2437,
            'power_mw': 100,
            'energy_mwh': 400,
            'duration_hours': 4,
            'technology': 'Lithium-ion (Tesla Megapack)',
            'status': 'Operational',
            'operator': 'Tesla Energy',
            'commission_year': 2023,
        }
    """
    locations = []
    site_counter = 1
    
    for state_name, state_info in US_BESS_STATES.items():
        num_sites = state_info['deployments']
        state_abbr = state_info['abbr']
        center_lat, center_lon = state_info['center']
        
        for i in range(num_sites):
            # Randomize location around state center
            # ± 2 degrees gives good spread within state
            lat = center_lat + random.uniform(-2, 2)
            lon = center_lon + random.uniform(-2, 2)
            
            # Generate capacity (MW and MWh)
            # US BESS typically 10-1000 MW
            power_mw = random.choice([10, 20, 50, 100, 150, 200, 250, 300, 500, 750, 1000])
            duration_hours = random.choice([1, 2, 4])  # 1-4 hour duration typical
            energy_mwh = power_mw * duration_hours
            
            # Select technology, use case, status
            technology = random.choice(BESS_TECHNOLOGIES)
            use_case = random.choice(USE_CASES)
            status = random.choice(PROJECT_STATUS)
            operator = random.choice(OPERATORS)
            
            # Commission year based on status
            if status == 'Operational':
                commission_year = random.randint(2020, 2024)
            elif status == 'Under Construction':
                commission_year = random.randint(2025, 2026)
            else:  # Planned
                commission_year = random.randint(2026, 2028)
            
            site = {
                'site_id': f'{state_abbr}-Site-{site_counter:03d}',
                'name': f'{state_name} {use_case} BESS #{i+1}',
                'state': state_name,
                'state_abbr': state_abbr,
                'latitude': round(lat, 4),
                'longitude': round(lon, 4),
                
                # Capacity
                'power_mw': power_mw,
                'energy_mwh': energy_mwh,
                'duration_hours': duration_hours,
                
                # Technology
                'technology': technology,
                'manufacturer': technology.split('(')[1].replace(')', '') if '(' in technology else 'Generic',
                
                # Project info
                'use_case': use_case,
                'status': status,
                'commission_year': commission_year,
                'operator': operator,
                
                # Grid connection
                'grid_voltage_kv': random.choice([138, 230, 345, 500]),
                'interconnection': random.choice(['PJM', 'CAISO', 'ERCOT', 'MISO', 'SPP', 'NYISO', 'ISO-NE']),
            }
            
            locations.append(site)
            site_counter += 1
    
    return locations


def generate_mock_timeseries(site_id, hours=24):
    """
    Generate time-series data for a specific BESS site
    
    Simulates realistic daily charging/discharging patterns:
    - Night: Light activity
    - Morning: Discharge (grid demand)
    - Afternoon: Charge (solar)
    - Evening: Discharge (peak demand)
    
    Args:
        site_id: Site identifier (e.g., 'CA-Site-001')
        hours: How many hours of historical data to generate
    
    Returns:
        List of data point dictionaries (one every 5 minutes)
    
    Example data point:
        {
            'site_id': 'CA-Site-001',
            'timestamp': '2024-12-19T10:00:00',
            'state_of_charge': 75.5,
            'power_mw': -50.2,  # Negative = discharging
            'ac_bus_voltage': 475.3,
            'dc_bus_voltage': 720.1,
            'temperature': 28.5,
            'status': 'Good',
        }
    """
    # Get site info
    locations = generate_mock_locations()
    site = next((s for s in locations if s['site_id'] == site_id), None)
    
    if not site:
        print(f"⚠️  Site {site_id} not found")
        return []
    
    power_mw = site['power_mw']
    energy_mwh = site['energy_mwh']
    
    # Time setup
    end_time = datetime.now()
    start_time = end_time - timedelta(hours=hours)
    current_time = start_time
    time_step = timedelta(minutes=5)  # Data point every 5 minutes
    
    # Initialize state of charge
    soc = random.uniform(60, 85)  # Start between 60-85%
    
    data_points = []
    
    while current_time <= end_time:
        hour_of_day = current_time.hour
        
        # Realistic power flow based on time of day
        # Negative = discharging, Positive = charging
        if 0 <= hour_of_day < 6:
            # Night: minimal activity
            base_power_mw = random.uniform(-power_mw * 0.1, power_mw * 0.3)
        elif 6 <= hour_of_day < 10:
            # Morning peak: discharge to grid
            base_power_mw = random.uniform(-power_mw * 0.8, -power_mw * 0.3)
        elif 10 <= hour_of_day < 16:
            # Afternoon: charge from solar
            base_power_mw = random.uniform(power_mw * 0.3, power_mw * 0.9)
        elif 16 <= hour_of_day < 21:
            # Evening peak: heavy discharge
            base_power_mw = random.uniform(-power_mw * 0.9, -power_mw * 0.5)
        else:
            # Late night: moderate activity
            base_power_mw = random.uniform(-power_mw * 0.4, power_mw * 0.1)
        
        # Add randomness
        power_mw_actual = base_power_mw + random.uniform(-power_mw * 0.05, power_mw * 0.05)
        power_mw_actual = max(-power_mw, min(power_mw, power_mw_actual))  # Clamp
        
        # Update State of Charge
        hours_elapsed = time_step.total_seconds() / 3600
        soc_change = (power_mw_actual * hours_elapsed / energy_mwh) * 100
        soc += soc_change
        soc = max(5, min(95, soc))  # Keep between 5-95%
        
        # AC voltage (drops under load)
        grid_voltage_kv = site['grid_voltage_kv']
        load_factor = abs(power_mw_actual) / power_mw
        voltage_drop = load_factor * 50
        ac_voltage = grid_voltage_kv * 1000 - voltage_drop + random.uniform(-20, 20)
        
        # DC voltage (varies with SOC)
        dc_voltage = 600 + (soc / 100) * 200 + random.uniform(-10, 10)
        
        # Temperature (increases with load)
        ambient = 25
        thermal_load = abs(power_mw_actual) / power_mw * 20
        battery_temp = ambient + thermal_load + random.uniform(-3, 3)
        inverter_temp = battery_temp + random.uniform(8, 15)
        
        # Revenue estimation
        # Higher prices during peak hours
        if 16 <= hour_of_day < 21:
            price_per_mwh = random.uniform(80, 150)
        else:
            price_per_mwh = random.uniform(20, 60)
        
        # Revenue only when discharging (selling to grid)
        revenue_per_hour = abs(power_mw_actual) * price_per_mwh if power_mw_actual < 0 else 0
        
        # Status (97% Good, 2% I/O Timeout, 1% Bad)
        status_roll = random.random()
        if status_roll < 0.97:
            status = "Good"
            is_online = True
        elif status_roll < 0.99:
            status = "I/O Timeout"
            is_online = False
        else:
            status = "Bad"
            is_online = True
        
        # Create data point
        data_point = {
            'site_id': site_id,
            'timestamp': current_time.isoformat(),
            
            # Power metrics
            'power_mw': round(power_mw_actual, 2),
            'energy_mwh': round(energy_mwh, 2),
            'state_of_charge': round(soc, 2),
            
            # Electrical parameters
            'ac_bus_voltage': round(ac_voltage, 2),
            'dc_bus_voltage': round(dc_voltage, 2),
            
            # Temperature
            'temperature': round(battery_temp, 2),
            'inverter_temp': round(inverter_temp, 2),
            
            # Grid
            'frequency': round(60.0 + random.uniform(-0.08, 0.08), 2),
            
            # Economics
            'price_per_mwh': round(price_per_mwh, 2),
            'revenue_usd_per_hour': round(revenue_per_hour, 2),
            
            # Status
            'status': status,
            'is_online': is_online,
        }
        
        data_points.append(data_point)
        current_time += time_step
    
    return data_points


def generate_mock_alerts():
    """
    Generate mock system alerts
    
    Returns:
        List of 2-6 alert dictionaries
    
    Example alert:
        {
            'id': 1,
            'site_id': 'CA-Site-001',
            'severity': 'WARNING',
            'message': 'High battery temperature detected',
            'created_at': '2024-12-19T09:30:00',
            'acknowledged': False,
        }
    """
    alert_templates = [
        {'message': 'High battery temperature detected', 'severity': 'WARNING'},
        {'message': 'Low state of charge warning', 'severity': 'WARNING'},
        {'message': 'Communication timeout', 'severity': 'CRITICAL'},
        {'message': 'AC voltage out of range', 'severity': 'CRITICAL'},
        {'message': 'Inverter overheating', 'severity': 'WARNING'},
        {'message': 'Power limit exceeded', 'severity': 'WARNING'},
        {'message': 'DC voltage anomaly', 'severity': 'WARNING'},
        {'message': 'Grid frequency deviation', 'severity': 'INFO'},
    ]
    
    sites = ['CA-Site-001', 'TX-Site-001', 'NY-Site-001', 'FL-Site-001']
    
    alerts = []
    num_alerts = random.randint(2, 6)
    
    for i in range(num_alerts):
        alert_template = random.choice(alert_templates)
        
        alert = {
            'id': i + 1,
            'site_id': random.choice(sites),
            'severity': alert_template['severity'],
            'message': alert_template['message'],
            'created_at': (datetime.now() - timedelta(minutes=random.randint(5, 240))).isoformat(),
            'acknowledged': random.choice([True, False]),
        }
        alerts.append(alert)
    
    # Sort by most recent first
    alerts.sort(key=lambda x: x['created_at'], reverse=True)
    return alerts


